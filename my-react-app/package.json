{
  "name": "my-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/optimize-assets.mjs",
    "predev": "npm run prepare:assets",
    "build": "npm run prepare:assets && vite build && node scripts/build-pages.mjs && node scripts/compress-build.mjs",
    "start": "node server/index.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "react-tsparticles": "^2.12.2",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@napi-rs/canvas": "^1.0.11",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vite": "^7.2.4"
  }
}
